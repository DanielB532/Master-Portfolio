---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, index: i, total: work.length, nextEntry: work[i + 1] ?? null } }));
}

const { entry, index, total, nextEntry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={`${d.title} | Daniel Boadu`} description={d.summary}>
  <section class="cs-hero">
    <div class="wrap">
      <article class="mail">
        <div class="mail-bar">
          <a class="back" href="/#inbox">← Back to inbox</a>
          <span class="mail-pos eyebrow">{pad(index + 1)} of {total}</span>
        </div>
        <div class="mail-labels">
          <span class="label-chip">{d.industry}</span>
          <span class="label-chip plain">Case study</span>
        </div>
        <h1>{d.title}</h1>
        <div class="sender">
          <span class="avatar" aria-hidden="true">DB</span>
          <div class="sender-meta">
            <p><b>Daniel Boadu</b> <span class="muted">· {d.client}</span></p>
            <p class="muted small">to hiring team · {d.period}</p>
          </div>
          <span class="stat-badge"><b>{d.headlineStat.value}</b> {d.headlineStat.label}</span>
        </div>
        <p class="cs-summary">{d.summary}</p>
        <div class="hero-grid">
          <div class="skills-shown">
            <p class="eyebrow">Skills shown</p>
            <div class="tags">{d.skillsShown.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
          <dl class="facts">
            {d.facts.map((f) => (<div><dt class="eyebrow">{f.label}</dt><dd>{f.value}</dd></div>))}
          </dl>
        </div>
      </article>
    </div>
  </section>

  <section class="section light">
    <div class="wrap prose"><Content /></div>
  </section>

  {d.sends && (
    <section class="section off">
      <div class="wrap">
        <div class="sec-head"><h2>The journey</h2><span class="eyebrow">{d.sends.length} sends, one job each</span></div>
        <div class="axis" aria-hidden="true">
          {d.sends.map((s) => <span>Sent {s.sent.replace(/ \d{4}$/, '')}</span>)}
          {d.timelineEnd && <span class="end">{d.timelineEnd}</span>}
        </div>
        <div class="sends" style={`--cols:${d.sends.length}`}>
          {d.sends.map((s) => (
            <article class="send">
              <header>
                <div class="job"><span>{s.job}</span><small class="eyebrow">{s.label}</small></div>
                <dl class="hdr"><dt>Subject</dt><dd>{s.subject}</dd><dt>Sent</dt><dd>{s.sent}</dd></dl>
              </header>
              <div class="body">
                {s.excerpt.map((p) => <p>{p}</p>)}
                <span class="cta">{s.cta}</span>
              </div>
              <footer>
                {s.stats.map((st) => (<div><b class="big-num">{st.value}</b><span class="eyebrow">{st.label}</span></div>))}
              </footer>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.phases && (
    <section class="section off">
      <div class="wrap">
        <div class="sec-head"><h2>{d.phasesTitle ?? 'The funnel'}</h2><span class="eyebrow">{d.phasesCaption ?? `${d.phases.length} stages`}</span></div>
        <div class="phases" style={`--pcols:${Math.min(d.phases.length, 4)}`}>
          {d.phases.map((ph, i) => (
            <article class="phase">
              <header>
                <span class="eyebrow red">{pad(i + 1)} · {ph.label}</span>
                <h3>{ph.job}</h3>
              </header>
              <ul>{ph.points.map((pt) => <li>{pt}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.gallery && d.galleryTitle && (
    <section id="samples" class="section light">
      <div class="wrap">
        <div class="sec-head"><h2>{d.galleryTitle}</h2><span class="eyebrow">{d.galleryCaption ?? `${d.gallery.length} examples`}</span></div>
        <div class:list={['samples', { phones: d.galleryFrame === 'phone' }]} style={d.galleryCols ? `--gcols:${d.galleryCols}` : undefined}>
          {d.gallery.map((g) => (
            <figure>
              <a href={g.full ?? g.image} target="_blank" rel="noopener" aria-label={`Open full email: ${g.caption}`}>
                <img src={g.image} alt={g.alt} loading="lazy" />
              </a>
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))}
        </div>
        <p class="eyebrow samples-note">Click any email to see it in full</p>
      </div>
    </section>
  )}

  {d.results && (
  <section id="results" class="section dark">
    <div class="wrap">
      <div class="sec-head"><h2>Results</h2><span class="eyebrow">{d.results.caption}</span></div>
      <div class="results">
        {d.results.items.map((r) => (<div class="result"><b class="big-num">{r.value}</b><p>{r.label}</p></div>))}
      </div>
      {d.proof && (
        <div class="proof">
          <figure>
            <img src={d.proof.image} alt={d.proof.alt} loading="lazy" />
            <figcaption class="eyebrow">{d.proof.caption}</figcaption>
          </figure>
          <p>{d.proof.text}</p>
        </div>
      )}
      {d.gallery && !d.galleryTitle && (
        <div class="gallery">
          {d.gallery.map((g) => (
            <figure>
              <img src={g.image} alt={g.alt} loading="lazy" />
              <figcaption class="eyebrow">{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
  )}

  {d.next && (
    <section class="section light">
      <div class="wrap next">
        <h2>What I'd do next</h2>
        <ol>{d.next.map((n) => <li>{n}</li>)}</ol>
      </div>
    </section>
  )}

  <section class="section off end-nav">
    <div class="wrap end-inner">
      {nextEntry ? (
        <a href={`/work/${nextEntry.id}/`} class="next-link"><span class="eyebrow">Next message</span><span class="nl-title">{nextEntry.data.title} →</span></a>
      ) : (
        <a href="/#inbox" class="next-link"><span class="eyebrow">End of inbox</span><span class="nl-title">Back to inbox →</span></a>
      )}
      <a class="btn red" href="/#compose">Reply</a>
    </div>
  </section>
</Base>

<style>
  .cs-hero { background: var(--canvas); padding-block: clamp(20px, 3vw, 32px) clamp(28px, 4vw, 48px); }
  .mail { background: var(--white); border-radius: 16px; padding: clamp(20px, 3vw, 40px); box-shadow: 0 1px 2px rgba(0,0,0,.05); --muted: var(--grey); --rule: var(--rule-light); }
  .mail-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--rule-light); }
  .back { text-decoration: none; font-weight: 700; font-size: 14px; color: var(--black); padding: 6px 12px; margin-left: -12px; border-radius: 999px; }
  .back:hover { background: #F0F0F2; }
  .mail-labels { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 22px; }
  .label-chip { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 3px 9px; border-radius: 4px; background: #F6DADB; color: #8E1A1E; }
  .label-chip.plain { background: #F0F0F2; color: var(--grey); }
  h1 { font-size: clamp(32px, 5vw, 64px); font-weight: 800; max-width: 20ch; margin-top: 14px; }
  .sender { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; align-items: center; margin-top: 24px; }
  .avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--red); color: var(--white); display: grid; place-items: center; font-weight: 800; font-size: 15px; }
  .muted { color: var(--grey); }
  .small { font-size: 13.5px; }
  .stat-badge { font-size: 13px; color: var(--grey); white-space: nowrap; text-align: right; }
  .stat-badge b { display: block; font-size: 26px; font-weight: 800; color: var(--black); line-height: 1; }
  .cs-summary { margin-top: 22px; font-size: clamp(17px, 1.8vw, 20px); color: #26262B; max-width: 64ch; line-height: 1.6; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); margin-top: clamp(24px, 4vw, 40px); align-items: start; }
  .skills-shown { display: grid; gap: 12px; }
  .skills-shown .tag { color: #3A3A40; border-color: var(--rule-light); border-radius: 6px; font-size: 12.5px; }
  .facts { margin: 0; display: grid; }
  .facts div { padding-block: 14px; border-bottom: 1px solid var(--rule); display: grid; gap: 4px; }
  .facts div:first-child { border-top: 1px solid var(--rule); }
  .facts dd { margin: 0; }

  .prose { max-width: 760px; display: grid; gap: 18px; }
  .prose :global(h2) { font-size: clamp(24px, 3vw, 32px); font-weight: 800; margin-top: 18px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(ul) { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; font-size: 18px; max-width: 62ch; }
  .prose :global(li::marker) { color: var(--red); }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(p) { font-size: 19px; line-height: 1.65; max-width: 62ch; }

  .axis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 20px; font-family: var(--mono); font-size: 13px; color: var(--muted); padding-bottom: 14px; border-bottom: 2px solid var(--black); }
  .axis .end { color: var(--red); font-weight: 500; }
  .sends { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 20px; margin-top: 24px; }
  .send { background: var(--white); border: 1px solid var(--rule); display: flex; flex-direction: column; min-width: 0; }
  .send header { padding: 18px 20px 14px; border-bottom: 1px solid var(--rule); }
  .job { display: flex; align-items: baseline; gap: 10px; }
  .job span { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
  .hdr { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; row-gap: 2px; font-family: var(--mono); font-size: 12.5px; margin: 12px 0 0; }
  .hdr dt { color: var(--muted); }
  .hdr dd { margin: 0; min-width: 0; }
  .body { padding: 18px 20px; display: grid; gap: 12px; font-size: 15px; line-height: 1.55; flex: 1; align-content: start; }
  .cta { color: #1A3FD6; text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
  .send footer { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--rule); }
  .send footer div { padding: 14px 16px; display: grid; gap: 4px; }
  .send footer div + div { border-left: 1px solid var(--rule); }
  .send footer b { font-size: 21px; }
  .send footer .eyebrow { font-size: 10.5px; }

  .phases { display: grid; grid-template-columns: repeat(var(--pcols, 4), minmax(0, 1fr)); gap: 20px; }
  .phase { background: var(--white); border: 1px solid var(--rule); min-width: 0; display: flex; flex-direction: column; }
  .phase header { padding: 18px 20px 14px; border-bottom: 1px solid var(--rule); display: grid; gap: 8px; }
  .phase h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  .phase ul { margin: 0; padding: 18px 20px 20px 36px; display: grid; gap: 10px; font-size: 15px; line-height: 1.5; }
  .phase li::marker { color: var(--red); }
  .gallery { margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 20px; align-items: start; }
  .gallery figure { margin: 0; background: var(--card); border: 1px solid var(--rule); padding: 14px; max-width: 520px; }
  .gallery figcaption { margin-top: 12px; }
  .samples { display: grid; grid-template-columns: repeat(var(--gcols, 4), minmax(0, 1fr)); gap: 20px; }
  .samples figure { margin: 0; display: grid; gap: 10px; align-content: start; }
  .samples a { display: block; overflow: hidden; background: var(--white); border: 1px solid var(--rule-light); border-radius: 10px; transition: transform .2s, box-shadow .2s; }
  .samples.phones a { border: 7px solid var(--black); border-top-width: 22px; border-radius: 26px; box-shadow: 0 10px 28px rgba(0,0,0,.14); position: relative; transition: transform .2s, box-shadow .2s; }
  .samples.phones a::before { content: ''; position: absolute; top: -15px; left: 50%; width: 52px; height: 6px; margin-left: -26px; border-radius: 6px; background: #2A2A2E; }
  .samples a:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(0,0,0,.18); }
  .samples figcaption { font-size: 14px; color: var(--muted); }
  .samples-note { margin-top: 20px; }
  .results { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .result { padding: 28px 20px 28px 0; display: grid; gap: 10px; align-content: start; }
  .result + .result { padding-left: 20px; border-left: 1px solid var(--rule); }
  .result b { font-size: clamp(36px, 4.6vw, 56px); white-space: nowrap; }
  .result:first-child b { color: var(--red-bright); }
  .result p { color: var(--muted); font-size: 15px; }
  .proof { margin-top: 36px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  .proof figure { margin: 0; background: var(--card); border: 1px solid var(--rule); padding: 14px; }
  .proof figcaption { margin-top: 12px; }
  .proof p { font-size: 18px; max-width: 44ch; }

  .next { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: clamp(28px, 6vw, 80px); }
  .next h2 { font-size: clamp(28px, 3.6vw, 40px); font-weight: 800; }
  .next ol { margin: 0; padding: 0; list-style: none; counter-reset: n; }
  .next li { counter-increment: n; display: grid; grid-template-columns: 2.5rem 1fr; padding-block: 18px; border-bottom: 1px solid var(--rule); font-size: 17px; }
  .next li:first-child { border-top: 1px solid var(--rule); }
  .next li::before { content: counter(n, decimal-leading-zero); font-family: var(--mono); font-size: 13px; color: var(--red); padding-top: 4px; }

  .end-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .next-link { text-decoration: none; display: grid; gap: 8px; }
  .nl-title { font-size: clamp(22px, 3vw, 32px); font-weight: 800; letter-spacing: -0.02em; }
  .next-link:hover .nl-title { color: var(--red); }

  @media (max-width: 640px) { .sender { grid-template-columns: auto minmax(0, 1fr); } .stat-badge { grid-column: 2; text-align: left; } }
  @media (max-width: 1080px) { .phases { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .phases { grid-template-columns: 1fr; } }
  @media (max-width: 960px) { .samples { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .hero-grid, .proof, .next { grid-template-columns: 1fr; }
    .sends { grid-template-columns: 1fr; }
    .axis { display: none; }
    .results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .result:nth-child(3) { padding-left: 0; border-left: 0; }
    .result:nth-child(n+3) { border-top: 1px solid var(--rule); }
  }
</style>
