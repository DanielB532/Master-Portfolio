---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, nextEntry: all[i + 1] ?? all[0] } }));
}
const { entry, nextEntry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const words = entry.body?.split(/\s+/).length ?? 0;
const mins = Math.max(1, Math.round(words / 220));
---
<Base title={`${d.short} | Daniel Boadu`} description={d.summary}>
  <section class="a-hero">
    <div class="wrap">
      <article class="mail">
        <div class="mail-bar"><a class="back" href="/#archive">← Back to archive</a><span class="eyebrow">{mins} min read</span></div>
        <p class="eyebrow red topic">{d.topic} · {d.date}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
      </article>
    </div>
  </section>
  <section class="section light">
    <article class="wrap body"><Content /></article>
  </section>
  {nextEntry && nextEntry.id !== entry.id && (
    <section class="section off">
      <div class="wrap end">
        <a href={`/writing/${nextEntry.id}/`} class="next"><span class="eyebrow">Next article</span><span class="t">{nextEntry.data.short} →</span></a>
        <a class="btn red" href="/#compose">Reply</a>
      </div>
    </section>
  )}
</Base>

<style>
  .a-hero { background: var(--canvas); padding-block: clamp(20px, 3vw, 32px) clamp(28px, 4vw, 48px); }
  .mail { background: var(--white); border-radius: 16px; padding: clamp(20px, 3vw, 40px); box-shadow: 0 1px 2px rgba(0,0,0,.05); }
  .mail-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--rule-light); }
  .mail-bar .eyebrow { color: var(--grey); }
  .back { text-decoration: none; font-weight: 700; font-size: 14px; color: var(--black); padding: 6px 12px; margin-left: -12px; border-radius: 999px; }
  .back:hover { background: #F0F0F2; }
  .topic { margin-top: 22px; color: var(--red); }
  h1 { font-size: clamp(30px, 4.2vw, 50px); font-weight: 800; max-width: 26ch; margin-top: 16px; }
  .lede { margin-top: 18px; color: #3A3A40; font-size: 19px; max-width: 60ch; }
  .body { max-width: 720px; }
  .body :global(h2) { font-size: clamp(22px, 2.6vw, 28px); font-weight: 800; margin: 40px 0 12px; }
  .body :global(p) { font-size: 18px; line-height: 1.75; margin: 0 0 18px; }
  .body :global(ul) { font-size: 18px; line-height: 1.7; padding-left: 1.2em; margin: 0 0 18px; }
  .body :global(li::marker) { color: var(--red); }
  .end { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .next { text-decoration: none; display: grid; gap: 8px; }
  .next .t { font-size: clamp(20px, 2.6vw, 28px); font-weight: 800; letter-spacing: -0.02em; }
  .next:hover .t { color: var(--red); }
</style>
