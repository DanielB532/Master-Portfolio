---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, experience, skills, aiBuilds, education, recommendation, coreSkills } from '../data/site';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base>
  <!-- Hero: styled like an email header -->
  <section class="hero dark">
    <div class="wrap">
      <dl class="envelope">
        <dt>Aka</dt><dd>{site.aka}</dd>
        <dt>Focus</dt><dd>{site.focus}</dd>
        <dt>Based</dt><dd>{site.location}</dd>
      </dl>
      <h1>{site.role} at <span class="hl">{site.company}</span></h1>
      <p class="lede">{site.intro}</p>
      <dl class="hero-stats">
        {site.stats.map((st) => (<div><dt class="big-num">{st.value}</dt><dd>{st.label}</dd></div>))}
      </dl>
      <div class="actions">
        <a class="btn red" href="#work">See my work</a>
        {site.cv && <a class="btn ghost" href={site.cv} target="_blank" rel="noopener">Download CV</a>}
        <a class="btn ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- Skills, each tied to evidence -->
  <section id="skills" class="section light">
    <div class="wrap">
      <div class="sec-head"><h2>What I bring</h2><span class="eyebrow">Skills, with proof</span></div>
      <div class="skill-grid">
        {skills.map((s, i) => (
          <article class="skill">
            <span class="eyebrow red">{pad(i + 1)}</span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            {s.proof.href
              ? <a class="proof-link" href={s.proof.href}>See it: {s.proof.label} →</a>
              : <span class="proof-link muted">{s.proof.label}</span>}
          </article>
        ))}
      </div>
      <div class="skill-extra">
        <div class="core"><p class="eyebrow">Core skills</p><div class="tags">{coreSkills.map((c) => <span class="tag">{c}</span>)}</div></div>
        <dl class="tools">
          {site.tools.map((t) => (<div><dt class="eyebrow">{t.group}</dt><dd>{t.items.join(' · ')}</dd></div>))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Work index -->
  <section id="work" class="section off">
    <div class="wrap">
      <div class="sec-head"><h2>Selected work</h2><span class="eyebrow">{pad(work.length)} case {work.length === 1 ? 'study' : 'studies'}</span></div>
      <ol class="index">
        {work.map((p, i) => (
          <li>
            <a href={`/work/${p.id}/`}>
              <span class="num">{pad(i + 1)}</span>
              <div class="txt">
                <h3>{p.data.title}</h3>
                <p class="meta">{p.data.client} · {p.data.tags.slice(0, 2).join(' · ')}</p>
              </div>
              <span class="stat"><b class="big-num">{p.data.headlineStat.value}</b>{p.data.headlineStat.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- AI -->
  <section id="ai" class="section dark">
    <div class="wrap">
      <div class="sec-head"><h2>AI in my work</h2><span class="eyebrow">{aiBuilds.length} builds</span></div>
      <div class="ai-intro">
        <p class="statement">I use AI to take the repetitive work out of marketing, so more time goes on the strategy and the copy.</p>
        <div class="ai-lede">
          <p>Every tool here started as a real problem in my day-to-day work. I scope it, write the instructions, test it against real campaigns and keep a human check on anything that gets sent.</p>
          <p>I use AI in my copywriting too. It speeds up first drafts and variations, as it did on the <a href="/work/stf26-cold-outbound/">Shoptalk cold emails</a>, while the strategy, structure and final edit stay mine.</p>
        </div>
      </div>
      <div class="ai-grid">
        {aiBuilds.map((b) => (
          <article class="ai-card">
            <div class="ai-top">
              <span class="eyebrow">{b.where}</span>
              <span class:list={['pill', b.status.toLowerCase().replace(/\s+/g, '-')]}>{b.status}</span>
            </div>
            <h3>{b.name}</h3>
            <dl class="ai-body">
              <div><dt class="eyebrow">Problem</dt><dd>{b.problem}</dd></div>
              <div><dt class="eyebrow">What I built</dt><dd>{b.solution}</dd></div>
            </dl>
            <p class="built"><span class="eyebrow">Built with</span> {b.built}</p>
            {b.link && <a class="ai-link" href={b.link.href} target="_blank" rel="noopener">{b.link.label} →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="section light">
    <div class="wrap">
      <div class="sec-head"><h2>Experience</h2><span class="eyebrow">{site.location}</span></div>
      <div class="exp-grid">
        <p class="statement">I care about the send after the send: what someone did last tells you what to say next.</p>
        <div>
          <ul class="exp">
            {experience.map((e) => (
              <li>
                <div class="exp-top"><h3>{e.role}</h3>{e.period && <span class="eyebrow">{e.period}</span>}</div>
                <p class="exp-co"><b>{e.company}</b> · {e.type}</p>
                <p class="exp-text">{e.text}</p>
                {e.highlights && <ul class="exp-hl">{e.highlights.map((h) => <li>{h}</li>)}</ul>}
                {(e.tools || e.link) && (
                  <div class="exp-foot">
                    {e.tools && <span class="eyebrow">Tools: {e.tools.join(' · ')}</span>}
                    {e.link && e.link.map((l) => <a href={l.href}>{l.label} →</a>)}
                  </div>
                )}
              </li>
            ))}
          </ul>
          <p class="edu"><span class="eyebrow">Education</span> {education.name}, {education.result}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recommendation -->
  <section id="recommendation" class="section off">
    <div class="wrap">
      <div class="sec-head"><h2>Recommendation</h2><span class="eyebrow">From LinkedIn</span></div>
      <figure class="rec">
        <blockquote>“{recommendation.quote}”</blockquote>
        <figcaption><b>{recommendation.name}</b><span class="eyebrow">{recommendation.context}</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section dark">
    <div class="wrap">
      <div class="sec-head"><h2>Contact</h2><span class="eyebrow">Via LinkedIn</span></div>
      <p class="contact-line">Hiring for email, CRM or lifecycle? Let's talk.</p>
      <div class="actions">
        <a class="btn red" href={site.linkedin} target="_blank" rel="noopener">Message me on LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(56px, 10vw, 120px) clamp(64px, 10vw, 120px); }
  .envelope {
    display: grid; grid-template-columns: auto 1fr; column-gap: 24px; row-gap: 6px;
    font-family: var(--mono); font-size: 14px; margin: 0; max-width: 620px;
    padding-bottom: 22px; border-bottom: 1px solid var(--rule);
  }
  .envelope dt { color: var(--muted); }
  .envelope dd { margin: 0; min-width: 0; }
  h1 { font-size: clamp(40px, 6.6vw, 84px); font-weight: 800; margin-top: 36px; max-width: 16ch; }
  .hl { color: var(--red); }
  .lede { margin-top: 28px; font-size: clamp(18px, 2vw, 20px); color: var(--muted); max-width: 56ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .index { list-style: none; margin: 0; padding: 0; }
  .index a {
    display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto 2rem; gap: 24px; align-items: center;
    padding-block: 28px; border-bottom: 1px solid var(--rule); text-decoration: none;
  }
  .index li:first-child a { border-top: 1px solid var(--rule); }
  .num { font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .index h3 { font-size: clamp(24px, 3.4vw, 36px); font-weight: 800; }
  .meta { margin-top: 8px; color: var(--muted); font-size: 15px; }
  .stat { font-family: var(--mono); font-size: 13px; color: var(--muted); text-align: right; }
  .stat b { display: block; font-family: var(--sans); font-size: 30px; color: var(--black); }
  .arrow { font-size: 24px; color: var(--red); transition: transform .2s; }
  .index a:hover .arrow { transform: translateX(6px); }
  .index a:hover h3 { color: var(--red); }

  .exp-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(28px, 6vw, 80px); }
  .statement { font-size: clamp(26px, 3.4vw, 38px); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; }
  .exp { list-style: none; margin: 0; padding: 0; }
  .exp li { padding-block: 22px; border-bottom: 1px solid var(--rule); display: grid; gap: 6px; }
  .exp li:first-child { border-top: 1px solid var(--rule); }
  .exp-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .exp h3 { font-size: 22px; font-weight: 800; letter-spacing: -0.01em; }
  .exp-text { color: var(--muted); max-width: 58ch; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #3FB950; box-shadow: 0 0 0 3px rgba(63,185,80,.2); }
  .skill-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .skill { padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .skill + .skill { padding-left: 24px; border-left: 1px solid var(--rule); }
  .skill h3 { font-size: 22px; font-weight: 800; letter-spacing: -0.015em; line-height: 1.15; }
  .skill p { color: var(--muted); font-size: 15.5px; flex: 1; }
  .proof-link { font-size: 14px; font-weight: 700; color: var(--red); text-decoration: none; }
  .proof-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .proof-link.muted { color: var(--muted); font-weight: 500; font-family: var(--mono); font-size: 12px; }
  .skill-extra { margin-top: 28px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); }
  .core { display: grid; gap: 12px; align-content: start; }
  .tools { margin: 0; display: grid; gap: 12px; }
  .tools div { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; align-items: baseline; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
  .tools dd { margin: 0; font-size: 15px; }
  @media (max-width: 860px) { .skill-extra { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .tools div { grid-template-columns: 1fr; gap: 4px; } }
  .exp-hl { margin: 6px 0 0; padding-left: 1.1em; display: grid; gap: 6px; font-size: 15px; max-width: 62ch; }
  .exp-hl li::marker { color: var(--red); }
  .exp-foot { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: baseline; }
  .exp-foot a { font-size: 14px; font-weight: 700; color: var(--red); text-decoration: none; }
  .exp-foot a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 960px) {
    .skill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .skill:nth-child(3) { padding-left: 0; border-left: 0; }
    .skill:nth-child(n+3) { border-top: 1px solid var(--rule); }
  }
  @media (max-width: 560px) {
    .skill-grid { grid-template-columns: 1fr; }
    .skill, .skill + .skill { padding: 24px 0; border-left: 0; }
    .skill + .skill { border-top: 1px solid var(--rule); }
  }

  .hero-stats { display: flex; flex-wrap: wrap; gap: 0; margin: 36px 0 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); max-width: 680px; }
  .hero-stats div { padding: 18px 28px 18px 0; display: grid; gap: 4px; }
  .hero-stats div + div { padding-left: 28px; border-left: 1px solid var(--rule); }
  .hero-stats dt { font-size: clamp(28px, 3.4vw, 40px); }
  .hero-stats dd { margin: 0; color: var(--muted); font-size: 14px; }

  .ai-intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 80px); align-items: end; margin-bottom: clamp(32px, 5vw, 56px); }
  .ai-lede { color: var(--muted); font-size: 17px; max-width: 48ch; display: grid; gap: 14px; }
  .ai-lede a { color: var(--white); text-decoration-color: var(--red); text-underline-offset: 3px; }
  .ai-link { font-size: 14px; font-weight: 700; color: var(--red-bright); text-decoration: none; }
  .ai-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ai-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .ai-card { background: var(--card); border: 1px solid var(--rule); padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .ai-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .ai-card h3 { font-size: clamp(24px, 2.6vw, 30px); font-weight: 800; }
  .ai-body { margin: 0; display: grid; gap: 14px; flex: 1; align-content: start; }
  .ai-body div { display: grid; gap: 4px; }
  .ai-body dd { margin: 0; color: #D4D4D8; font-size: 15.5px; }
  .built { font-size: 14px; padding-top: 14px; border-top: 1px solid var(--rule); display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; }
  .pill { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 4px 10px; border: 1px solid currentColor; white-space: nowrap; }
  .pill.in-use, .pill.live { color: #3FB950; }
  .pill.in-development { color: #E3B341; }
  .pill.built { color: var(--grey-light); }

  .exp-co { font-size: 15px; color: var(--muted); }
  .exp-co b { color: var(--black); font-weight: 700; }
  .edu { margin-top: 22px; font-size: 15px; display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline; }

  .rec { margin: 0; max-width: 900px; }
  .rec blockquote { margin: 0; font-size: clamp(22px, 2.8vw, 32px); font-weight: 700; line-height: 1.3; letter-spacing: -0.015em; text-wrap: pretty; }
  .rec figcaption { margin-top: 24px; display: grid; gap: 4px; padding-left: 16px; border-left: 3px solid var(--red); }

  .contact-line { font-size: clamp(32px, 5vw, 60px); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; max-width: 18ch; text-wrap: balance; }

  @media (max-width: 860px) { .exp-grid, .ai-intro, .ai-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .hero-stats div { padding-right: 18px; } .hero-stats div + div { padding-left: 18px; } }
  @media (max-width: 600px) {
    .index a { grid-template-columns: minmax(0, 1fr) auto; gap: 12px 16px; }
    .num, .arrow { display: none; }
    .stat b { font-size: 24px; }
  }
</style>
