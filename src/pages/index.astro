---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, experience, skills, aiBuilds, education, recommendation, coreSkills } from '../data/site';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const industries = [...new Set(work.map((w) => w.data.industry))];
const folders = [
  { id: 'inbox', label: 'Case studies', count: work.length, icon: 'inbox', note: 'Inbox' },
  { id: 'automations', label: 'AI tools', count: aiBuilds.length, icon: 'bolt', note: 'Automations' },
  { id: 'sent', label: 'Experience', count: experience.length, icon: 'send', note: 'Sent' },
  { id: 'replies', label: 'Recommendation', count: 1, icon: 'reply', note: 'Replies' },
  { id: 'integrations', label: 'Tools & skills', count: site.tools.reduce((n, t) => n + t.items.length, 0), icon: 'plug', note: 'Integrations' },
  { id: 'archive', label: 'Writing', count: writing.length, icon: 'archive', note: 'Archive' },
];
const icons: Record<string, string> = {
  inbox: 'M3 11l2.5-6h9L17 11v5H3v-5zm0 0h4l1 2h4l1-2h4',
  bolt: 'M11 2L4 11h5l-1 7 7-9h-5l1-7z',
  send: 'M3 10l14-6-6 14-2-6-6-2z',
  reply: 'M8 5L3 10l5 5M3 10h9a5 5 0 015 5v1',
  archive: 'M3 4h14v4H3zM4 8v8h12V8M8 11h4',
  plug: 'M7 2v5M13 2v5M5 7h10v3a5 5 0 01-10 0V7zM10 15v3',
};
const pad = (n: number) => String(n).padStart(2, '0');
const initials = `${site.firstName[0]}${site.lastName[0]}`;
---
<Base search>
  <div class="client">
    <!-- Folder rail (a tab strip on smaller screens) -->
    <aside class="folders" aria-label="Sections">
      <nav>
        <a href="#top" class="folder active" data-folder="top">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14v10H3zM3 5l7 6 7-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span>About me<small>New message</small></span><b class="dot-new">1</b>
        </a>
        {folders.map((f) => (
          <a href={`#${f.id}`} class="folder" data-folder={f.id}>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d={icons[f.icon]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></svg>
            <span>{f.label}<small>{f.note}</small></span><em>{f.count}</em>
          </a>
        ))}
      </nav>
    </aside>

    <div class="panes">
      <!-- 1. The opened email: who I am -->
      <article id="top" class="pane message hero" data-pane="top">
        <div class="msg-toolbar">
          <span class="eyebrow">Inbox › New message</span>
          <span class="eyebrow">Just now</span>
        </div>
        <h1 class="subject">{site.role.replace('-', '\u2011')} at <span class="hl">{site.company}</span></h1>
        <div class="sender">
          <span class="avatar" aria-hidden="true">{initials}</span>
          <div class="sender-meta">
            <p><b>{site.firstName} {site.lastName}</b> <span class="muted addr">&lt;{site.email}&gt;</span></p>
            <p class="muted small">to you · {site.focus} · {site.location}</p>
          </div>
        </div>
        <div class="msg-body">
          <p class="greeting">Hi there,</p>
          <p class="lede">{site.intro}</p>
          <dl class="hero-stats">
            {site.stats.map((st) => (<div><dt class="big-num">{st.value}</dt><dd>{st.label}</dd></div>))}
          </dl>
          <p class="eyebrow in-this">In this email</p>
          <ol class="skills">
            {skills.map((s, i) => (
              <li>
                <span class="n">{pad(i + 1)}</span>
                <div><b>{s.name}</b><span>{s.text}</span></div>
                {s.proof.href ? <a href={s.proof.href}>{s.proof.label} →</a> : <span class="muted small">{s.proof.label}</span>}
              </li>
            ))}
          </ol>
          <div class="signoff">
            <p>Best,</p>
            <p class="sig"><b>{site.firstName}</b> <span class="muted">{site.aka}</span></p>
          </div>
          <div class="actions">
            <a class="btn red" href="#inbox">Open my work</a>
            {site.cv && <a class="btn ghost" href={site.cv} target="_blank" rel="noopener">Download CV</a>}
            <a class="btn ghost" href="#compose">Reply</a>
          </div>
        </div>
      </article>

      <!-- Brand strip -->
      <div class="marquee" aria-label={`Brands I've worked on: ${site.brands.join(', ')}`}>
        <span class="eyebrow mq-label">Worked on</span>
        <div class="mq-window" aria-hidden="true">
          <div class="mq-track">
            {[0, 1].map(() => (
              <div class="mq-group">{site.brands.map((b) => <span>{b}</span>)}</div>
            ))}
          </div>
        </div>
      </div>

      <!-- 2. Inbox: case studies -->
      <section id="inbox" class="pane" data-pane="inbox">
        <header class="pane-head">
          <div><h2>Case studies</h2><p class="muted small">Inbox · {work.length} conversations</p></div>
          <div class="chips" role="group" aria-label="Filter by industry">
            <button type="button" class="chip on" data-filter="all">All</button>
            {industries.map((ind) => <button type="button" class="chip" data-filter={ind}>{ind}</button>)}
          </div>
        </header>
        <ul class="list" id="inbox-list">
          {work.map((p, i) => (
            <li class:list={['row', { unread: i < 2 }]} data-industry={p.data.industry} data-search={`${p.data.title} ${p.data.client} ${p.data.summary} ${p.data.industry} ${p.data.tags.join(' ')} ${p.data.skillsShown.join(' ')}`.toLowerCase()}>
              <a href={`/work/${p.id}/`}>
                <span class="u"></span>
                <span class="from">{p.data.client}</span>
                <span class="line"><b class="subj">{p.data.title}</b><span class="prev"> — {p.data.summary}</span></span>
                <span class="meta-r">
                  <span class="tag">{p.data.industry}</span>
                  <span class="stat">{p.data.headlineStat.value} <small>{p.data.headlineStat.label}</small></span>
                  <span class="date">{p.data.period}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="empty" hidden>No messages match that search. <button type="button" class="linkish" data-clear>Clear search</button></p>
      </section>

      <!-- 3. Automations: AI builds and a working UTM builder -->
      <section id="automations" class="pane dark-pane" data-pane="automations">
        <header class="pane-head">
          <div><h2>AI tools</h2><p class="small grey">Automations I've built · {aiBuilds.length} running</p></div>
        </header>
        <p class="statement">I use AI to take the repetitive work out of marketing, so more time goes on the strategy and the copy.</p>
        <p class="grey ai-note">Every tool here started as a real problem in my day-to-day work. I use AI in my copywriting too: it speeds up first drafts, as it did on the <a href="/work/stf26-cold-outbound/">Shoptalk cold emails</a>, while the strategy and final edit stay mine.</p>

        <ul class="rules">
          {aiBuilds.map((b) => {
            const on = ['In use', 'Live', 'Done'].includes(b.status);
            return (
              <li class="rule" data-search={`${b.name} ${b.solution} ${b.built} ai automation`.toLowerCase()}>
                <span class:list={['toggle', { on }]} role="img" aria-label={on ? 'On' : 'Off'}><i></i></span>
                <div class="rule-main">
                  <p class="rule-name">{b.name} <span class="eyebrow">{b.where} · {b.status}</span></p>
                  <p class="rule-desc">{b.solution}</p>
                  <p class="rule-meta"><span class="eyebrow">Built with</span> {b.built}{b.link && <> · <a href={b.link.href} target={b.link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{b.link.label} →</a></>}</p>
                </div>
              </li>
            );
          })}
        </ul>

        <div class="utm" id="utm">
          <div class="utm-head">
            <p class="eyebrow red">Try it</p>
            <h3>UTM link builder</h3>
            <p class="grey small">A lighter version of the UTM Tagging Assistant I built for Hyve. Paste a link and it tags, tidies and checks it, ready to paste into HubSpot.</p>
          </div>
          <form class="utm-form" id="utm-form">
            <label><span class="eyebrow">Link</span><input id="utm-url" type="text" inputmode="url" value="https://example.com/register" /></label>
            <div class="utm-row">
              <label><span class="eyebrow">Source</span><input id="utm-source" type="text" value="newsletter" /></label>
              <label><span class="eyebrow">Medium</span><input id="utm-medium" type="text" value="email" /></label>
            </div>
            <label><span class="eyebrow">Campaign</span><input id="utm-campaign" type="text" value="Shoptalk Fall 2026 Early Bird" /></label>
            <div class="utm-out">
              <code id="utm-result" aria-live="polite"></code>
              <button type="button" id="utm-copy" class="btn red sm">Copy link</button>
            </div>
            <p id="utm-notes" class="utm-notes grey small" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <!-- 4. Sent: experience -->
      <section id="sent" class="pane" data-pane="sent">
        <header class="pane-head">
          <div><h2>Experience</h2><p class="muted small">Sent · {experience.length} roles · click a role for results</p></div>
          <p class="eyebrow">{education.name}, {education.result}</p>
        </header>
        <ul class="list">
          {experience.map((e) => (
            <li class="row sent" data-search={`${e.company} ${e.role} ${e.text} ${(e.highlights ?? []).join(' ')}`.toLowerCase()}>
              <details>
                <summary>
                  <span class="from">{e.company}</span>
                  <span class="line"><b class="subj">{e.role}</b><span class="prev"> — {e.text}</span></span>
                  <span class="meta-r"><span class="tag plain">{e.type}</span><span class="date">{e.period}</span></span>
                </summary>
                <div class="sent-body">
                  <p>{e.text}</p>
                  {e.highlights && <ul>{e.highlights.map((h) => <li>{h}</li>)}</ul>}
                  {(e.tools || e.link) && (
                    <div class="sent-foot">
                      {e.tools && <span class="eyebrow">Tools: {e.tools.join(' · ')}</span>}
                      {e.link && e.link.map((l) => <a href={l.href}>{l.label} →</a>)}
                    </div>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>

      <!-- 5. Replies: recommendation -->
      <section id="replies" class="pane" data-pane="replies">
        <header class="pane-head"><div><h2>Recommendation</h2><p class="muted small">Replies · what clients say</p></div></header>
        <div class="thread">
          <div class="reply-meta">
            <span class="avatar alt" aria-hidden="true">{recommendation.name.split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>
            <div><p><b>{recommendation.name}</b> <span class="muted">replied</span></p><p class="muted small">{recommendation.context}</p></div>
          </div>
          <blockquote>{recommendation.quote}</blockquote>
        </div>
      </section>

      <!-- 6. Integrations: tools and core skills -->
      <section id="integrations" class="pane" data-pane="integrations">
        <header class="pane-head"><div><h2>Tools &amp; skills</h2><p class="muted small">Integrations · the tools I work in, and the skills I bring to them</p></div></header>
        <div class="apps">
          {site.tools.map((t) => (
            <div class="app-group">
              <p class="eyebrow">{t.group}</p>
              <div class="app-chips">{t.items.map((i) => <span class="app">{i}</span>)}</div>
            </div>
          ))}
        </div>
        <p class="eyebrow core-label">Core skills</p>
        <div class="tags">{coreSkills.map((c) => <span class="tag-chip">{c}</span>)}</div>
      </section>

      <!-- 7. Archive: writing -->
      <section id="archive" class="pane" data-pane="archive">
        <header class="pane-head"><div><h2>Writing</h2><p class="muted small">Archive · earlier long-form articles</p></div></header>
        <ul class="list">
          {writing.map((w) => (
            <li class="row" data-search={`${w.data.title} ${w.data.topic} ${w.data.summary}`.toLowerCase()}>
              <a href={`/writing/${w.id}/`}>
                <span class="u"></span>
                <span class="from">{w.data.topic}</span>
                <span class="line"><b class="subj">{w.data.short}</b><span class="prev"> — {w.data.summary}</span></span>
                <span class="meta-r"><span class="date">{w.data.date}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- 8. Compose: contact -->
      <section id="compose" class="pane compose" data-pane="compose">
        <header class="compose-head"><span>New message</span><span class="eyebrow">Email me for any enquiries</span></header>
        <form id="compose-form" class="compose-form">
          <div class="field"><span>To</span><input type="text" value={site.email} readonly aria-label="To" /></div>
          <div class="field"><label for="c-subject">Subject</label><input id="c-subject" type="text" placeholder="Let's talk about…" /></div>
          <textarea id="c-body" rows="6" placeholder={`Hi ${site.firstName},`} aria-label="Message"></textarea>
          <div class="compose-actions">
            <button type="submit" class="btn red">Send</button>
            <a class="btn ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            <span class="muted small">Opens your email app. Or copy my address: <button type="button" class="linkish" id="copy-email">{site.email}</button></span>
          </div>
        </form>
      </section>
    </div>
  </div>

  <div class="toast" id="toast" role="status" hidden>
    <span class="avatar sm" aria-hidden="true">{initials}</span>
    <div><b>New message from {site.firstName} {site.lastName}</b><span>{site.role} at {site.company}</span></div>
  </div>
</Base>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('.client');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // "New message" toast, once per visit
    const toast = document.getElementById('toast');
    let seen = false;
    try { seen = sessionStorage.getItem('db-toast') === '1'; sessionStorage.setItem('db-toast', '1'); } catch {}
    if (toast && !seen) {
      setTimeout(() => { toast.hidden = false; requestAnimationFrame(() => toast.classList.add('in')); }, 700);
      setTimeout(() => { toast.classList.remove('in'); setTimeout(() => (toast.hidden = true), 400); }, 5400);
    }

    // Search (top bar) and label filters across every list
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-search]'));
    const inboxRows = Array.from(document.querySelectorAll<HTMLElement>('#inbox-list .row'));
    const empty = document.querySelector<HTMLElement>('#inbox .empty');
    const searchInput = document.getElementById('inbox-search') as HTMLInputElement | null;
    let query = '';
    let industry = 'all';
    const apply = () => {
      rows.forEach((r) => {
        const okQ = !query || (r.dataset.search ?? '').includes(query);
        const okI = industry === 'all' || !r.dataset.industry || r.dataset.industry === industry;
        r.hidden = !(okQ && okI);
      });
      if (empty) empty.hidden = inboxRows.some((r) => !r.hidden);
      document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.classList.toggle('on', b.dataset.filter === industry));
    };
    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter ?? 'all';
      industry = industry === f && f !== 'all' ? 'all' : f;
      apply();
      if (b.classList.contains('label-btn')) document.getElementById('inbox')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    }));
    document.querySelector('[data-clear]')?.addEventListener('click', () => { query = ''; if (searchInput) searchInput.value = ''; industry = 'all'; apply(); });

    // Highlight the folder for the section in view
    const links = Array.from(document.querySelectorAll<HTMLElement>('.folder'));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const id = (en.target as HTMLElement).dataset.pane;
        links.forEach((l) => {
          const on = l.dataset.folder === id;
          l.classList.toggle('active', on);
          if (on && innerWidth <= 1000) l.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' });
        });
      });
    }, { rootMargin: '-35% 0px -60% 0px' });
    document.querySelectorAll('[data-pane]').forEach((p) => io.observe(p));

    // UTM builder
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const slug = (s: string) => s.trim().toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const out = document.getElementById('utm-result');
    const notes = document.getElementById('utm-notes');
    const build = () => {
      const raw = $('utm-url').value.trim();
      const fixes: string[] = [];
      let url: URL;
      try {
        if (!raw) throw new Error('empty');
        const hasScheme = /^https?:\/\//i.test(raw);
        url = new URL(hasScheme ? raw : `https://${raw}`);
        if (!url.hostname.includes('.')) throw new Error('host');
        if (!hasScheme) fixes.push('Added https://');
      } catch {
        if (out) out.textContent = 'Enter a link to see the tagged version.';
        if (notes) notes.textContent = '';
        return;
      }
      const fields: [string, string][] = [['utm_source', 'utm-source'], ['utm_medium', 'utm-medium'], ['utm_campaign', 'utm-campaign']];
      fields.forEach(([key, id]) => {
        const v = $(id).value;
        const s = slug(v);
        if (v.trim() && s !== v.trim()) fixes.push(`Tidied ${key.replace('utm_', '')}: "${v.trim()}" → "${s}"`);
        if (url.searchParams.has(key) && s) fixes.push(`Replaced an existing ${key}`);
        if (s) url.searchParams.set(key, s); else url.searchParams.delete(key);
      });
      const missing = fields.filter(([, id]) => !slug($(id).value)).map(([k]) => k.replace('utm_', ''));
      if (out) out.textContent = url.toString();
      if (notes) notes.textContent = missing.length
        ? `Missing ${missing.join(' and ')}, so reporting will be incomplete.`
        : fixes.length ? `✓ ${fixes.join(' · ')}` : '✓ All three parameters present and consistent.';
    };
    ['utm-url', 'utm-source', 'utm-medium', 'utm-campaign'].forEach((id) => $(id)?.addEventListener('input', build));
    document.getElementById('utm-form')?.addEventListener('submit', (e) => e.preventDefault());
    build();
    document.getElementById('utm-copy')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(out?.textContent ?? ''); btn.textContent = 'Copied'; }
      catch { if (out) { const r = document.createRange(); r.selectNodeContents(out); getSelection()?.removeAllRanges(); getSelection()?.addRange(r); } btn.textContent = 'Selected'; }
      setTimeout(() => (btn.textContent = 'Copy link'), 1600);
    });

    // Compose: opens the visitor's email app with their subject and message filled in
    document.getElementById('compose-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const subject = encodeURIComponent($('c-subject').value.trim() || 'Hello from your portfolio');
      const body = encodeURIComponent((document.getElementById('c-body') as HTMLTextAreaElement).value);
      location.href = `mailto:danielboadu03@gmail.com?subject=${subject}&body=${body}`;
    });
    document.getElementById('copy-email')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const t = btn.textContent ?? '';
      try { await navigator.clipboard.writeText(t); btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = t), 1400); } catch {}
    });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* Layout: an email client. Folder rail on the left, white message panes on a grey canvas. */
  :global(body) { background: var(--canvas); }
  .client { display: grid; grid-template-columns: 236px minmax(0, 1fr); gap: 24px; max-width: 1440px; margin: 0 auto; padding: 24px var(--gutter) 64px; }

  /* Folder rail */
  .folders { position: sticky; top: 92px; align-self: start; display: grid; gap: 22px; }
  .compose-side { display: inline-flex; align-items: center; gap: 10px; justify-self: start; background: var(--white); color: var(--black); border: 1px solid var(--rule-light); border-radius: 18px; padding: 15px 22px; font-weight: 700; text-decoration: none; box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 4px 14px rgba(0,0,0,.06); transition: transform .15s, box-shadow .15s; }
  .compose-side:hover { transform: translateY(-1px); box-shadow: 0 2px 4px rgba(0,0,0,.08), 0 8px 20px rgba(0,0,0,.1); }
  .compose-side svg { width: 18px; height: 18px; color: var(--red); }
  .folders nav { display: grid; gap: 2px; }
  .folder { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 8px 14px; border-radius: 0 999px 999px 0; text-decoration: none; color: #3A3A40; font-size: 14.5px; transition: background .15s, color .15s; }
  .folder svg { width: 18px; height: 18px; }
  .folder small { display: block; font-size: 11px; color: var(--grey); font-family: var(--mono); }
  .folder em { font-style: normal; font-family: var(--mono); font-size: 12px; color: var(--grey); }
  .folder:hover { background: #E0E0E4; }
  .folder.active { background: #F6DADB; color: var(--black); font-weight: 700; }
  .folder.active svg, .folder.active em { color: var(--red); }
  .dot-new { background: var(--red); color: var(--white); font-size: 11px; border-radius: 999px; padding: 1px 7px; }
  .labels { display: grid; gap: 2px; padding-left: 14px; }
  .labels .eyebrow { margin-bottom: 6px; }
  .label-btn { all: unset; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: #3A3A40; padding: 5px 0; }
  .label-btn i { width: 10px; height: 10px; border-radius: 3px; border: 2px solid var(--red); }
  .label-btn.on { font-weight: 700; color: var(--black); }
  .label-btn.on i { background: var(--red); }
  .label-btn:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

  /* Panes */
  .panes { display: grid; gap: 20px; min-width: 0; }
  .pane { background: var(--white); border-radius: 16px; padding: clamp(20px, 3vw, 36px); box-shadow: 0 1px 2px rgba(0,0,0,.05); scroll-margin-top: 90px; min-width: 0; }
  .pane-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px 16px; flex-wrap: wrap; padding-bottom: 18px; border-bottom: 1px solid var(--rule-light); }
  .pane-head h2 { font-size: 26px; font-weight: 800; }
